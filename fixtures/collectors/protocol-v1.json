{
  "manifest": {
    "sdkVersion": "1",
    "id": "harnesscope.synthetic.collector",
    "name": "Synthetic Collector",
    "version": "0.4.0",
    "platforms": ["linux", "macos"],
    "capabilities": [
      "process.lifecycle",
      "process.metadata",
      "file.metadata",
      "collector.diagnostics"
    ],
    "requiresExplicitPaths": true,
    "requiresTargetLaunch": true,
    "contentCapture": "unsupported"
  },
  "envelope": {
    "sdkVersion": "1",
    "collectorId": "harnesscope.synthetic.collector",
    "instanceId": "instance-1",
    "sequence": 4,
    "kind": "event",
    "event": {
      "source": "collector",
      "kind": "ProcessStarted",
      "correlationId": "pid:1234",
      "data": {
        "pid": 1234
      }
    }
  }
}
