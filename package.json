{
  "name": "harnesscope",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Clean-room coding-agent harness inspector and behavioral spec exporter",
  "main": "apps/desktop/main.mjs",
  "bin": {
    "harnesscope": "./bin/harnesscope.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node ./bin/harnesscope.mjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:win": "electron-builder --win nsis zip --x64 --publish never",
    "desktop:mac": "electron-builder --mac dmg zip --universal --publish never",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config apps/tauri/src-tauri/tauri.conf.json",
    "tauri:win": "tauri build --config apps/tauri/src-tauri/tauri.conf.json --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "tauri:mac": "tauri build --config apps/tauri/src-tauri/tauri.conf.json --target universal-apple-darwin --bundles dmg,app"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.trinhtanphat.harnesscope",
    "productName": "HarnessScope",
    "asar": true,
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "apps/desktop/**/*",
      "src/**/*",
      "ui/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "HarnessScope-${version}-windows-portable.${ext}"
    },
    "nsis": {
      "artifactName": "HarnessScope-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "artifactName": "HarnessScope-${version}-macos-universal.${ext}",
      "category": "public.app-category.developer-tools"
    }
  },
  "license": "Apache-2.0"
}
